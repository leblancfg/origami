+bool llama_context::expert_eval(ggml_tensor * tensor, bool ask) {
+    if (ask) {
+        const bool need_expert = expert_stream->callback(tensor, true);
+        const bool need_user = cparams.cb_eval && cparams.cb_eval(tensor, true, cparams.cb_eval_user_data);
