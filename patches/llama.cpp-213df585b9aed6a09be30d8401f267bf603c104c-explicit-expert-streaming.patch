+bool feature_enabled(std::string & error) {
+    const char * value = std::getenv("LLAMA_EXPLICIT_EXPERT_STREAMING");
+    if (value == nullptr || std::strcmp(value, "0") == 0) {
+        error = "LLAMA_EXPLICIT_EXPERT_STREAMING is not exactly 1";
+        return false;
+    }
+    if (std::strcmp(value, "1") != 0) {
+        error = "invalid LLAMA_EXPLICIT_EXPERT_STREAMING value (expected 0 or 1)";
+        return false;
+    }
+    return true;
+}
+
+bool valid_gate_up_type(ggml_type type) {
+    return type == GGML_TYPE_IQ1_S || type == GGML_TYPE_IQ2_XXS;
+}
+
+bool same_slice(const llama_expert_stream_slice & a, const llama_expert_stream_slice & b) {
+    return a.file_index == b.file_index && a.offset == b.offset &&
+           a.nbytes == b.nbytes && a.type == b.type;
+}
+
+bool add_overflows(uint64_t a, uint64_t b) {
+    return b > std::numeric_limits<uint64_t>::max() - a;
+}
+
+} // namespace
+
+struct llama_expert_stream_cache::impl {
+    struct slot {
+        bool valid = false;
+        uint32_t refs = 0;
+        uint64_t last_used = 0;
+        uint32_t layer = 0;
+        uint32_t expert = 0;
+        llama_expert_stream_slice gate;
+        llama_expert_stream_slice up;
+        llama_expert_stream_slice down;
+    };
+
+    struct pending {
+        std::vector<uint32_t> slots;
+        std::unique_ptr<llama_expert_stream_completion> completion;
+    };
+
+    llama_expert_stream_config config;
+    std::vector<std::unique_ptr<llama_file>> files;
+    ggml_backend_buffer_t buffer = nullptr;
+    uint8_t * base = nullptr;
+    size_t bytes = 0;
+
+    mutable std::mutex mutex;
+    std::condition_variable condition;
+    std::deque<pending> pending_releases;
+    std::vector<slot> slots;
+    std::thread completion_worker;
+    bool stopping = false;
+
+    uint64_t clock = 0;
+    llama_expert_stream_stats counters;
+
+#if defined(_WIN32)
+    std::mutex windows_io_mutex;
+#endif
+
+    impl(const llama_expert_stream_config & config, const std::vector<std::string> & paths) : config(config) {
+        if (config.cache_slots == 0 || config.slot_bytes == 0 || config.backend == nullptr) {
+            throw std::runtime_error("expert stream cache requires nonzero slots, slot bytes, and a backend");
+        }
+        if (config.cache_slots > UINT32_MAX) {
+            throw std::runtime_error("expert stream cache has more than UINT32_MAX slots");
+        }
+        if (config.cache_slots > std::numeric_limits<size_t>::max() / config.slot_bytes) {
+            throw std::runtime_error("expert stream cache byte capacity overflows size_t");
+        }
+        if (paths.empty()) {
+            throw std::runtime_error("expert stream cache requires at least one shard");
+        }
+
+        bytes = config.cache_slots * config.slot_bytes;
+        const ggml_backend_dev_t device = ggml_backend_get_device(config.backend);
+        if (device == nullptr) {
+            throw std::runtime_error("expert stream cache backend has no device");
+        }
+        buffer = ggml_backend_buft_alloc_buffer(ggml_backend_dev_buffer_type(device), bytes);
+        if (buffer == nullptr) {
+            throw std::runtime_error("failed to allocate bounded expert stream buffer");
+        }
+        ggml_backend_buffer_set_usage(buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        base = static_cast<uint8_t *>(ggml_backend_buffer_get_base(buffer));
+        if (base == nullptr) {
+            ggml_backend_buffer_free(buffer);
+            buffer = nullptr;
+            throw std::runtime_error("expert stream buffer is not host writable");
+        }
+
+        try {
+            files.reserve(paths.size());
+            for (const std::string & path : paths) {
+                files.emplace_back(new llama_file(path.c_str(), "rb"));
+            }
+            slots.resize(config.cache_slots);
+            completion_worker = std::thread([this] { completion_loop(); });
+        } catch (...) {
+            ggml_backend_buffer_free(buffer);
+            buffer = nullptr;
+            throw;
+        }
+    }
+
+    ~impl() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stopping = true;
+        }
+        condition.notify_one();
+        if (completion_worker.joinable()) {
+            completion_worker.join();
+        }
+        ggml_backend_buffer_free(buffer);
+    }
+
+    void completion_loop() {
+        for (;;) {
+            pending item;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                condition.wait(lock, [this] { return stopping || !pending_releases.empty(); });
+                if (pending_releases.empty()) {
+                    if (stopping) {
+                        return;
+                    }
+                    continue;
+                }
+                item = std::move(pending_releases.front());
+                pending_releases.pop_front();
+            }
+
+            // Reusing a slot after an uncertain completion would let Metal read
+            // overwritten quantized bytes. A completion implementation must not
+            // recover from a failed wait.
+            item.completion->wait();
+
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                release_locked(item.slots);
+            }
+        }
+    }
+
+    void release_locked(const std::vector<uint32_t> & owned_slots) {
+        for (uint32_t index : owned_slots) {
+            if (index >= slots.size() || slots[index].refs == 0) {
+                std::terminate();
+            }
+            slots[index].refs--;
+        }
+    }
+
+    bool request_valid(const llama_expert_stream_request & request, std::string & error) const {
+        if (!valid_gate_up_type(request.gate.type) || !valid_gate_up_type(request.up.type) ||
+            request.down.type != GGML_TYPE_IQ4_NL) {
+            error = "unsupported expert quant types (need IQ1_S/IQ2_XXS gate/up and IQ4_NL down)";
+            return false;
+        }
+
+        const llama_expert_stream_slice slices[] = { request.gate, request.up, request.down };
+        uint64_t total = 0;
+        for (const auto & slice : slices) {
+            if (slice.file_index >= files.size() || slice.nbytes == 0) {
+                error = "invalid expert shard index or empty slice";
+                return false;
+            }
+            if (slice.offset > files[slice.file_index]->size() ||
+                slice.nbytes > files[slice.file_index]->size() - slice.offset) {
+                error = "expert slice is outside its shard";
+                return false;
+            }
+            if (add_overflows(total, slice.nbytes)) {
+                error = "expert slice byte sum overflows";
+                return false;
+            }
+            total += slice.nbytes;
+        }
+        if (total > config.slot_bytes || total > std::numeric_limits<size_t>::max()) {
+            error = "expert slices exceed the fixed slot size";
+            return false;
+        }
+        return true;
+    }
+
+    bool matches(const slot & candidate, const llama_expert_stream_request & request) const {
+        return candidate.valid && candidate.layer == request.layer && candidate.expert == request.expert &&
+               same_slice(candidate.gate, request.gate) && same_slice(candidate.up, request.up) &&
+               same_slice(candidate.down, request.down);
+    }
+
+    bool read_exact(const llama_expert_stream_slice & slice, uint8_t * dst, std::string & error) {
+#if defined(_WIN32)
+        // Windows has no pread(). Serialize seek/read while retaining positional,
+        // bounded behavior. The Apple path below never changes the file cursor.
+        try {
+            std::lock_guard<std::mutex> io_lock(windows_io_mutex);
+            files[slice.file_index]->seek(static_cast<size_t>(slice.offset), SEEK_SET);
+            files[slice.file_index]->read_raw(dst, static_cast<size_t>(slice.nbytes));
+            return true;
+        } catch (const std::exception & exc) {
+            error = exc.what();
+            return false;
+        }
+#else
+        if (slice.offset > static_cast<uint64_t>(std::numeric_limits<off_t>::max())) {
+            error = "expert slice offset exceeds off_t";
+            return false;
+        }
+
+        uint64_t done = 0;
+        const int fd = files[slice.file_index]->file_id();
+        while (done < slice.nbytes) {
+            const uint64_t remaining = slice.nbytes - done;
+            const size_t count = static_cast<size_t>(std::min<uint64_t>(
+                    remaining, static_cast<uint64_t>(std::numeric_limits<ssize_t>::max())));
+            ssize_t result;
+            do {
+                result = pread(fd, dst + static_cast<size_t>(done), count,
+                               static_cast<off_t>(slice.offset + done));
+            } while (result < 0 && errno == EINTR);
+            if (result <= 0) {
+                error = result == 0 ? "short expert pread" : std::string("expert pread failed: ") + std::strerror(errno);
+                return false;
+            }
+            done += static_cast<uint64_t>(result);
+        }
+        return true;
+#endif
+    }
+
+    bool load(uint32_t index, const llama_expert_stream_request & request, std::string & error) {
+        uint8_t * dst = base + static_cast<size_t>(index) * config.slot_bytes;
+        size_t offset = 0;
+        const llama_expert_stream_slice slices[] = { request.gate, request.up, request.down };
+        for (const auto & slice : slices) {
+            if (!read_exact(slice, dst + offset, error)) {
+                slots[index].valid = false;
+                return false;
+            }
+            offset += static_cast<size_t>(slice.nbytes);
+            counters.read_bytes += slice.nbytes;
+        }
+
+        slot & loaded = slots[index];
+        loaded.valid = true;
+        loaded.layer = request.layer;
+        loaded.expert = request.expert;
+        loaded.gate = request.gate;
+        loaded.up = request.up;
+        loaded.down = request.down;
+        loaded.last_used = ++clock;
+        return true;
+    }
+
+    llama_expert_stream_view make_view(uint32_t index) const {
+        const slot & current = slots[index];
+        const size_t slot_offset = static_cast<size_t>(index) * config.slot_bytes;
+        const size_t up_offset = slot_offset + static_cast<size_t>(current.gate.nbytes);
+        const size_t down_offset = up_offset + static_cast<size_t>(current.up.nbytes);
+
+        llama_expert_stream_view view;
+        view.layer = current.layer;
+        view.expert = current.expert;
+        view.slot = index;
+        view.buffer = buffer;
+        view.gate = { base + slot_offset, slot_offset, static_cast<size_t>(current.gate.nbytes), current.gate.type };
+        view.up = { base + up_offset, up_offset, static_cast<size_t>(current.up.nbytes), current.up.type };
+        view.down = { base + down_offset, down_offset, static_cast<size_t>(current.down.nbytes), current.down.type };
+        return view;
+    }
+};
+
+llama_expert_stream_lease::llama_expert_stream_lease() = default;
+
+llama_expert_stream_lease::~llama_expert_stream_lease() {
+    if (owner != nullptr) {
+        owner->release(std::move(slots));
+    }
+}
+
+llama_expert_stream_lease::llama_expert_stream_lease(llama_expert_stream_lease && other) noexcept {
+    *this = std::move(other);
+}
+
+llama_expert_stream_lease & llama_expert_stream_lease::operator=(llama_expert_stream_lease && other) noexcept {
+    if (this != &other) {
+        if (owner != nullptr) {
+            owner->release(std::move(slots));
+        }
+        owner = other.owner;
+        slots = std::move(other.slots);
+        result_views = std::move(other.result_views);
+        other.owner = nullptr;
+        other.slots.clear();
+        other.result_views.clear();
+    }
+    return *this;
+}
+
+const std::vector<llama_expert_stream_view> & llama_expert_stream_lease::views() const {
+    return result_views;
+}
+
+bool llama_expert_stream_lease::empty() const {
+    return result_views.empty();
+}
+
+llama_expert_stream_cache::llama_expert_stream_cache(std::unique_ptr<impl> pimpl) : pimpl(std::move(pimpl)) {}
+
+std::unique_ptr<llama_expert_stream_cache> llama_expert_stream_cache::create(
+        const llama_expert_stream_config & config,
+        const std::vector<std::string> & files,
+        std::string & error) {
+    error.clear();
+    if (!feature_enabled(error)) {
+        return nullptr;
+    }
+    try {
+        return std::unique_ptr<llama_expert_stream_cache>(
+                new llama_expert_stream_cache(std::make_unique<impl>(config, files)));
+    } catch (const std::exception & exc) {
+        error = exc.what();
+        return nullptr;
+    }
+}
+
+llama_expert_stream_cache::~llama_expert_stream_cache() = default;
+
+bool llama_expert_stream_cache::acquire(
+        const std::vector<llama_expert_stream_request> & requests,
+        uint32_t n_tokens,
+        llama_expert_stream_lease & lease,
+        std::string & error) {
+    error.clear();
+    if (n_tokens != 1) {
+        error = "explicit expert streaming only supports single-token decode";
+        return false;
+    }
+    if (requests.empty() || requests.size() > pimpl->config.cache_slots) {
+        error = "selected expert count is empty or exceeds cache slots";
+        return false;
+    }
+    if (!lease.empty() || lease.owner != nullptr) {
+        error = "output expert lease is already active";
+        return false;
+    }
+    for (const auto & request : requests) {
+        if (!pimpl->request_valid(request, error)) {
+            return false;
+        }
+    }
+
+    std::lock_guard<std::mutex> lock(pimpl->mutex);
+    std::vector<uint32_t> acquired;
+    std::vector<llama_expert_stream_view> views;
+    acquired.reserve(requests.size());
+    views.reserve(requests.size());
+
+    for (const auto & request : requests) {
+        uint32_t index = UINT32_MAX;
+        for (uint32_t i = 0; i < pimpl->slots.size(); ++i) {
+            if (pimpl->matches(pimpl->slots[i], request)) {
+                index = i;
+                pimpl->counters.hits++;
+                break;
+            }
+        }
+
+        if (index == UINT32_MAX) {
+            uint64_t oldest = std::numeric_limits<uint64_t>::max();
+            for (uint32_t i = 0; i < pimpl->slots.size(); ++i) {
+                const auto & candidate = pimpl->slots[i];
+                if (candidate.refs != 0) {
+                    continue;
+                }
+                if (!candidate.valid) {
+                    index = i;
+                    break;
+                }
+                if (candidate.last_used < oldest) {
+                    oldest = candidate.last_used;
+                    index = i;
+                }
+            }
+            if (index == UINT32_MAX) {
+                pimpl->release_locked(acquired);
+                error = "all expert cache slots are owned by unfinished device work";
+                return false;
+            }
+            if (pimpl->slots[index].valid) {
+                pimpl->counters.evictions++;
+            }
+            if (!pimpl->load(index, request, error)) {
+                pimpl->release_locked(acquired);
+                return false;
+            }
+            pimpl->counters.misses++;
+        }
+
+        auto & selected = pimpl->slots[index];
+        selected.refs++;
+        selected.last_used = ++pimpl->clock;
+        acquired.push_back(index);
+        views.push_back(pimpl->make_view(index));
+    }
+
+    lease.owner = this;
+    lease.slots = std::move(acquired);
+    lease.result_views = std::move(views);
+    return true;
+}
+
+bool llama_expert_stream_cache::retire(
+        llama_expert_stream_lease && lease,
+        std::unique_ptr<llama_expert_stream_completion> completion,
+        std::string & error) {
+    error.clear();
+    if (lease.owner != this || lease.slots.empty()) {
+        error = "expert lease does not belong to this cache";
+        return false;
+    }
+    if (!completion) {
+        error = "expert lease retirement requires a completion fence";
+        return false;
+    }
+
+    impl::pending item;
+    item.slots = std::move(lease.slots);
+    item.completion = std::move(completion);
+    lease.owner = nullptr;
+    lease.result_views.clear();
+
+    {
+        std::lock_guard<std::mutex> lock(pimpl->mutex);
+        if (pimpl->stopping) {
+            error = "expert completion worker is stopping";
+            // Restore RAII ownership so destruction cannot expose the slots.
+            lease.owner = this;
+            lease.slots = std::move(item.slots);
+            return false;
+        }
+        pimpl->pending_releases.emplace_back(std::move(item));
+    }
+    pimpl->condition.notify_one();
+    return true;
+}
+
+void llama_expert_stream_cache::release(std::vector<uint32_t> && slots) {
+    std::lock_guard<std::mutex> lock(pimpl->mutex);
+    pimpl->release_locked(slots);
+}
+
+llama_expert_stream_stats llama_expert_stream_cache::stats() const {
+    std::lock_guard<std::mutex> lock(pimpl->mutex);
+    return pimpl->counters;
+}
+
+size_t llama_expert_stream_cache::capacity_bytes() const {
+    return pimpl->bytes;
+}
+
+size_t llama_expert_stream_cache::slot_bytes() const {
+    return pimpl->config.slot_bytes;
+}
+
+ggml_backend_buffer_t llama_expert_stream_cache::backend_buffer() const {
+    return pimpl->buffer;
+}
+
+void * llama_expert_stream_cache::buffer_base() const {
+    return pimpl->base;
+}
+
+struct llama_expert_stream_runtime::impl {
+    llama_expert_stream_model_info info;
+    ggml_backend_t backend = nullptr;
+    std::unique_ptr<llama_expert_stream_cache> cache;
+    ggml_backend_sched_t sched = nullptr;
+    uint32_t n_tokens = 0;
+    std::vector<llama_expert_stream_graph_layer> graph_layers;
+    llama_expert_stream_lease lease;
+    std::vector<int32_t> original_ids;
+    int active_layer = -1;
+    std::string error;
+
+    impl(llama_expert_stream_model_info info, ggml_backend_t backend,
+         std::unique_ptr<llama_expert_stream_cache> cache) :
+        info(std::move(info)), backend(backend), cache(std::move(cache)) {}
+
+    bool fail(const std::string & message) {
+        error = message;
+        return false;
+    }
+
+    static bool valid_op(const llama_expert_stream_graph_layer & layer, ggml_tensor * op,
+                         ggml_tensor * weight) {
+        return op != nullptr && op->op == GGML_OP_MUL_MAT_ID &&
+               op->src[0] == weight && op->src[2] == layer.selected;
+    }
+
+    bool acquire_layer(llama_expert_stream_graph_layer & layer) {
+        if (active_layer != -1 || !lease.empty()) {
+            return fail("expert routing boundary reached with an active lease");
+        }
+        if (sched == nullptr || n_tokens != 1 || layer.selected == nullptr || layer.boundary == nullptr) {
+            return fail("expert routing boundary has invalid graph state");
+        }
+        if (!valid_op(layer, layer.gate_op, layer.weights.gate) ||
+            !valid_op(layer, layer.up_op, layer.weights.up) ||
+            !valid_op(layer, layer.down_op, layer.weights.down)) {
+            return fail("scheduler copied or rewrote a routed expert tensor; refusing dynamic routing");
+        }
+
+        const ggml_tensor * weights[] = { layer.weights.gate, layer.weights.up, layer.weights.down };
+        for (const ggml_tensor * weight : weights) {
+            if (weight == nullptr || weight->buffer != cache->backend_buffer() ||
+                ggml_backend_sched_get_tensor_backend(sched, const_cast<ggml_tensor *>(weight)) != backend) {
+                return fail("routed expert cache tensor backend changed after scheduler assignment");
+            }
+        }
+
+        ggml_backend_t ids_backend = ggml_backend_sched_get_tensor_backend(sched, layer.selected);
+        if (ids_backend != backend) {
+            return fail("selected expert IDs were assigned away from the expert cache backend");
+        }
+        if (layer.selected->type != GGML_TYPE_I32 || layer.selected->ne[0] != info.n_expert_used ||
+            layer.selected->ne[1] != 1 || ggml_nbytes(layer.selected) != info.n_expert_used*sizeof(int32_t)) {
+            return fail("selected expert IDs do not have the single-token compact shape");
+        }
+
+        original_ids.resize(info.n_expert_used);
+        ggml_backend_tensor_get(layer.selected, original_ids.data(), 0, ggml_nbytes(layer.selected));
+
+        std::vector<llama_expert_stream_request> requests;
+        requests.reserve(original_ids.size());
+        const auto & source = info.layers.at(layer.il).experts;
+        for (int32_t id : original_ids) {
+            if (id < 0 || static_cast<uint32_t>(id) >= info.n_expert) {
+                return fail("router produced an out-of-range original expert ID");
+            }
+            requests.push_back(source.at(static_cast<size_t>(id)));
+        }
+
+        if (!cache->acquire(requests, n_tokens, lease, error)) {
+            return false;
+        }
+
+        std::vector<int32_t> slots;
+        slots.reserve(lease.views().size());
+        for (const auto & view : lease.views()) {
+            slots.push_back(static_cast<int32_t>(view.slot));
+        }
+        ggml_backend_tensor_set(layer.selected, slots.data(), 0, slots.size()*sizeof(slots[0]));
+        active_layer = static_cast<int>(&layer - graph_layers.data());
+        return true;
+    }
+
+    bool retire_layer(llama_expert_stream_graph_layer & layer) {
+        const int index = static_cast<int>(&layer - graph_layers.data());
+        if (active_layer != index || lease.empty() || original_ids.size() != info.n_expert_used) {
+            return fail("expert output boundary does not match the active lease");
+        }
+
+        // The scheduler synchronizes before ask=false. Restore the host-visible
+        // routing tensor only after ffn_moe_out is complete, then enqueue a Metal
+        // event after all commands that could read the leased slots.
+        ggml_backend_tensor_set(layer.selected, original_ids.data(), 0,
+                                original_ids.size()*sizeof(original_ids[0]));
+        auto completion = llama_expert_stream_metal_completion(backend, error);
+        if (!completion) {
+            active_layer = -1;
+            original_ids.clear();
+            return false;
+        }
+        if (!cache->retire(std::move(lease), std::move(completion), error)) {
+            active_layer = -1;
+            original_ids.clear();
+            return false;
+        }
+        active_layer = -1;
+        original_ids.clear();
+        return true;
+    }
+};
+
+namespace {
+
+bool parse_cache_slots(uint32_t minimum, size_t & slots, std::string & error) {
+    const char * value = std::getenv("LLAMA_EXPERT_CACHE_SLOTS");
+    if (value == nullptr) {
+        slots = static_cast<size_t>(minimum)*2;
+        return true;
+    }
+    if (*value == '\0' || *value == '-' || *value == '+') {
+        error = "LLAMA_EXPERT_CACHE_SLOTS must be an unsigned integer";
+        return false;
+    }
+    char * end = nullptr;
+    errno = 0;
+    const unsigned long long parsed = std::strtoull(value, &end, 10);
+    if (errno != 0 || end == value || *end != '\0' || parsed < minimum || parsed > UINT32_MAX) {
+        error = "LLAMA_EXPERT_CACHE_SLOTS must fit uint32 and cover all selected experts";
+        return false;
+    }
+    slots = static_cast<size_t>(parsed);
+    return true;
+}
+
+size_t padded_slot_bytes(const llama_expert_stream_model_info & info) {
+    size_t largest = 0;
+    for (const auto & layer : info.layers) {
+        if (layer.gate.nbytes > SIZE_MAX - layer.up.nbytes ||
+            layer.gate.nbytes + layer.up.nbytes > SIZE_MAX - layer.down.nbytes) {
+            throw std::runtime_error("expert projection byte sum overflows size_t");
+        }
+        largest = std::max(largest, layer.gate.nbytes + layer.up.nbytes + layer.down.nbytes);
+    }
+    constexpr size_t alignment = 4096;
+    if (largest == 0 || largest > SIZE_MAX - (alignment - 1)) {
+        throw std::runtime_error("invalid expert cache slot size");
+    }
+    return (largest + alignment - 1) & ~(alignment - 1);
+}
+
+void validate_model_info(const llama_expert_stream_model_info & info) {
+    if (info.files.empty() || info.layers.empty() || info.n_expert == 0 ||
+        info.n_expert_used == 0 || info.n_expert_used > info.n_expert) {
+        throw std::runtime_error("incomplete explicit expert source metadata");
+    }
+    for (size_t il = 0; il < info.layers.size(); ++il) {
+        const auto & layer = info.layers[il];
+        if (layer.experts.size() != info.n_expert) {
+            throw std::runtime_error("explicit expert layer does not cover every expert");
+        }
+        const llama_expert_stream_projection_layout layouts[] = { layer.gate, layer.up, layer.down };
+        for (const auto & layout : layouts) {
+            if (layout.ne0 <= 0 || layout.ne1 <= 0 || layout.nbytes == 0 || layout.type == GGML_TYPE_COUNT) {
+                throw std::runtime_error("invalid explicit expert projection layout");
+            }
+        }
+        for (size_t expert = 0; expert < layer.experts.size(); ++expert) {
+            const auto & request = layer.experts[expert];
+            if (request.layer != il || request.expert != expert ||
+                request.gate.nbytes != layer.gate.nbytes || request.gate.type != layer.gate.type ||
+                request.up.nbytes != layer.up.nbytes || request.up.type != layer.up.type ||
+                request.down.nbytes != layer.down.nbytes || request.down.type != layer.down.type) {
+                throw std::runtime_error("explicit expert request disagrees with its projection layout");
+            }
+        }
+    }
+}
+
+} // namespace
+
+llama_expert_stream_runtime::llama_expert_stream_runtime(std::unique_ptr<impl> pimpl) : pimpl(std::move(pimpl)) {}
+llama_expert_stream_runtime::~llama_expert_stream_runtime() = default;
+
+std::unique_ptr<llama_expert_stream_runtime> llama_expert_stream_runtime::create(
+        const llama_expert_stream_model_info & info,
+        ggml_backend_t backend,
+        std::string & error) {
+    error.clear();
+    if (!feature_enabled(error)) {
+        return nullptr;
+    }
+#if defined(GGML_USE_METAL)
+    if (backend == nullptr || !ggml_backend_is_metal(backend)) {
+        error = "explicit expert graph integration requires the Metal backend";
+        return nullptr;
+    }
+#else
+    (void) backend;
+    error = "explicit expert graph integration was built without Metal";
+    return nullptr;
+#endif
+
+    try {
+        validate_model_info(info);
+        size_t slots = 0;
+        if (!parse_cache_slots(info.n_expert_used, slots, error)) {
+            return nullptr;
+        }
+        const llama_expert_stream_config config = { slots, padded_slot_bytes(info), backend };
+        auto cache = llama_expert_stream_cache::create(config, info.files, error);
+        if (!cache) {
+            return nullptr;
+        }
+        return std::unique_ptr<llama_expert_stream_runtime>(
+                new llama_expert_stream_runtime(std::make_unique<impl>(info, backend, std::move(cache))));
+    } catch (const std::exception & exc) {
+        error = exc.what();
+        return nullptr;
+    }
+}
+
+void llama_expert_stream_runtime::begin_graph(ggml_backend_sched_t sched, uint32_t n_tokens) {
+    if (!pimpl->lease.empty() || pimpl->active_layer != -1) {
+        throw std::runtime_error("cannot replace an expert graph with device work in flight");
+    }
+    pimpl->sched = sched;
+    pimpl->n_tokens = n_tokens;
+    pimpl->graph_layers.clear();
+    pimpl->graph_layers.reserve(pimpl->info.layers.size());
+    pimpl->error.clear();
+}
+
+llama_expert_stream_graph_tensors llama_expert_stream_runtime::make_layer_tensors(
+        ggml_context * ctx, uint32_t il) {
+    if (ctx == nullptr || il >= pimpl->info.layers.size()) {
+        throw std::runtime_error("invalid explicit expert graph layer");
+    }
+    const auto & layout = pimpl->info.layers[il];
+    const size_t offsets[] = { 0, layout.gate.nbytes, layout.gate.nbytes + layout.up.nbytes };
+    const llama_expert_stream_projection_layout projections[] = { layout.gate, layout.up, layout.down };
+    ggml_tensor * tensors[3] = { nullptr, nullptr, nullptr };
+
+    for (size_t i = 0; i < 3; ++i) {
+        const auto & projection = projections[i];
+        const size_t cache_slots = pimpl->cache->capacity_bytes()/pimpl->cache->slot_bytes();
+        ggml_tensor * tensor = ggml_new_tensor_3d(ctx, projection.type, projection.ne0, projection.ne1,
+                                                  cache_slots);
+        tensor->nb[2] = pimpl->cache->slot_bytes();
+        tensor->nb[3] = tensor->nb[2]*tensor->ne[2];
+        ggml_format_name(tensor, "expert_cache.%u.%zu", il, i);
+        uint8_t * address = static_cast<uint8_t *>(pimpl->cache->buffer_base()) + offsets[i];
+        if (ggml_backend_tensor_alloc(pimpl->cache->backend_buffer(), tensor, address) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("failed to bind routed expert tensor to bounded cache");
+        }
+        tensors[i] = tensor;
+    }
+    return { tensors[0], tensors[1], tensors[2] };
+}
+
+llama_expert_stream_graph_layer * llama_expert_stream_runtime::add_layer(
+        uint32_t il, const llama_expert_stream_graph_tensors & weights) {
+    if (il >= pimpl->info.layers.size() || weights.gate == nullptr || weights.up == nullptr || weights.down == nullptr) {
+        throw std::runtime_error("cannot register invalid explicit expert graph layer");
+    }
+    pimpl->graph_layers.push_back({});
+    auto & layer = pimpl->graph_layers.back();
+    layer.il = il;
+    layer.weights = weights;
+    return &layer;
+}
+
+bool llama_expert_stream_runtime::callback(ggml_tensor * tensor, bool ask) {
+    for (auto & layer : pimpl->graph_layers) {
+        if (tensor == layer.boundary) {
+            return ask ? true : pimpl->acquire_layer(layer);
+        }
+        if (tensor == layer.output) {
+            return ask ? true : pimpl->retire_layer(layer);
+        }
+    }
+    return false;
+}
+
+bool llama_expert_stream_runtime::supports_decode(uint32_t n_tokens, std::string & error) const {
+    error.clear();
+    if (n_tokens != 1) {
+        error = "explicit expert streaming only supports one-token ubatches; prefill is disabled";
+        return false;
+    }
+    return true;
+}
+
+const std::string & llama_expert_stream_runtime::last_error() const { return pimpl->error; }
+ggml_backend_t llama_expert_stream_runtime::backend() const { return pimpl->backend; }
+llama_expert_stream_stats llama_expert_stream_runtime::stats() const { return pimpl->cache->stats(); }
+
+#if defined(GGML_USE_METAL)
+namespace {
+
+class llama_expert_stream_metal_event final : public llama_expert_stream_completion {
+public:
+    explicit llama_expert_stream_metal_event(ggml_backend_event_t event) : event(event) {}
+    ~llama_expert_stream_metal_event() override {
+        ggml_backend_event_free(event);
+    }
+
+    void wait() override {
+        ggml_backend_event_synchronize(event);
+    }
+
+private:
+    ggml_backend_event_t event;
+};
+
+} // namespace
+#endif
+
+std::unique_ptr<llama_expert_stream_completion> llama_expert_stream_metal_completion(
+        ggml_backend_t backend,
+        std::string & error) {
+    error.clear();
+#if defined(GGML_USE_METAL)
+    if (backend == nullptr || !ggml_backend_is_metal(backend)) {
+        error = "expert streaming completion requires the Metal backend";
+        return nullptr;
+    }
+    ggml_backend_event_t event = ggml_backend_event_new(ggml_backend_get_device(backend));
+    if (event == nullptr) {
+        error = "Metal backend did not provide a completion event";
+        return nullptr;
+    }
+    ggml_backend_event_record(event, backend);
+    return std::make_unique<llama_expert_stream_metal_event>(event);
+#else
+    (void) backend;
+    error = "llama.cpp was built without Metal expert completion support";
+    return nullptr;
+#endif
+}
