+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+#define CHECK(condition) do { if (!(condition)) { std::fprintf(stderr, "CHECK failed: %s:%d: %s\n", __FILE__, __LINE__, #condition); std::abort(); } } while (0)
+
+void set_feature(const char * value) {
+#if defined(_WIN32)
+    _putenv_s("LLAMA_EXPLICIT_EXPERT_STREAMING", value ? value : "");
+#else
+    if (value) {
+        setenv("LLAMA_EXPLICIT_EXPERT_STREAMING", value, 1);
+    } else {
+        unsetenv("LLAMA_EXPLICIT_EXPERT_STREAMING");
+    }
+#endif
+}
+
+std::filesystem::path temp_path(const char * stem) {
+    const auto nonce = std::chrono::steady_clock::now().time_since_epoch().count();
+    return std::filesystem::temp_directory_path() /
+           (std::string("llama-") + stem + "-" + std::to_string(nonce) + ".bin");
+}
+
+std::vector<uint8_t> make_bytes(size_t size, uint8_t salt) {
+    std::vector<uint8_t> bytes(size);
+    for (size_t i = 0; i < size; ++i) {
+        bytes[i] = static_cast<uint8_t>((i * 37 + salt) & 0xff);
+    }
+    return bytes;
+}
+
+void write_bytes(const std::filesystem::path & path, const std::vector<uint8_t> & bytes) {
+    std::ofstream out(path, std::ios::binary);
+    CHECK(out.good());
+    out.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    CHECK(out.good());
+}
+
+llama_expert_stream_request request_a() {
+    llama_expert_stream_request request;
+    request.layer = 7;
+    request.expert = 401;
+    request.gate = { 0, 37, 17, GGML_TYPE_IQ1_S };
+    request.up   = { 1, 101, 19, GGML_TYPE_IQ2_XXS };
+    request.down = { 0, 333, 23, GGML_TYPE_IQ4_NL };
+    return request;
+}
+
+llama_expert_stream_request request_b() {
+    llama_expert_stream_request request;
+    request.layer = 8;
+    request.expert = 9;
+    request.gate = { 1, 511, 16, GGML_TYPE_IQ2_XXS };
+    request.up   = { 0, 701, 18, GGML_TYPE_IQ1_S };
+    request.down = { 1, 911, 24, GGML_TYPE_IQ4_NL };
+    return request;
+}
+
+struct completion_state {
+    std::mutex mutex;
+    std::condition_variable condition;
+    bool done = false;
+};
+
+class blocking_completion final : public llama_expert_stream_completion {
+public:
+    explicit blocking_completion(std::shared_ptr<completion_state> state) : state(std::move(state)) {}
+
+    void wait() override {
+        std::unique_lock<std::mutex> lock(state->mutex);
+        state->condition.wait(lock, [this] { return state->done; });
+    }
+
+private:
+    std::shared_ptr<completion_state> state;
+};
+
+void signal(const std::shared_ptr<completion_state> & state) {
+    {
+        std::lock_guard<std::mutex> lock(state->mutex);
+        state->done = true;
+    }
+    state->condition.notify_one();
+}
+
+struct remap_callback_data {
+    ggml_tensor * boundary = nullptr;
+    ggml_tensor * ids = nullptr;
+    bool remapped = false;
+};
+
+bool remap_after_boundary(ggml_tensor * tensor, bool ask, void * user_data) {
+    auto * data = static_cast<remap_callback_data *>(user_data);
+    if (tensor != data->boundary) {
+        return false;
+    }
+    if (ask) {
+        return true;
+    }
+    const int32_t compact_id = 1;
+    ggml_backend_tensor_set(data->ids, &compact_id, 0, sizeof(compact_id));
+    data->remapped = true;
+    return true;
+}
+
+void test_scheduler_id_remap_boundary(ggml_backend_t backend) {
+    const size_t graph_size = 64;
+    ggml_backend_t backends[] = { backend };
+    ggml_backend_buffer_type_t bufts[] = { ggml_backend_get_default_buffer_type(backend) };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, bufts, 1, graph_size, false, false);
+    CHECK(sched != nullptr);
+
+    const size_t mem_size = 32*ggml_tensor_overhead() + ggml_graph_overhead_custom(graph_size, false);
+    ggml_init_params params = { mem_size, nullptr, true };
+    ggml_context * ctx = ggml_init(params);
+    CHECK(ctx != nullptr);
+    ggml_cgraph * graph = ggml_new_graph_custom(ctx, graph_size, false);
+
+    ggml_tensor * experts = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, 1, 2);
+    ggml_tensor * input = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, 1, 1);
+    ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, 1);
+    ggml_set_input(experts);
+    ggml_set_input(input);
+    ggml_set_input(ids);
+
+    // The callback synchronizes immediately after this node, then remaps the
+    // original ID 0 to compact cache slot 1 before MUL_MAT_ID is submitted.
+    ggml_tensor * boundary = ggml_dup(ctx, input);
+    ggml_tensor * output = ggml_mul_mat_id(ctx, experts, boundary, ids);
+    ggml_build_forward_expand(graph, output);
+
+    CHECK(ggml_backend_sched_alloc_graph(sched, graph));
+    const float expert_values[] = { 2.0f, 7.0f };
+    const float input_value = 3.0f;
+    const int32_t original_id = 0;
+    ggml_backend_tensor_set(experts, expert_values, 0, sizeof(expert_values));
+    ggml_backend_tensor_set(input, &input_value, 0, sizeof(input_value));
+    ggml_backend_tensor_set(ids, &original_id, 0, sizeof(original_id));
+
+    remap_callback_data callback = { boundary, ids, false };
+    ggml_backend_sched_set_eval_callback(sched, remap_after_boundary, &callback);
+    CHECK(ggml_backend_sched_graph_compute(sched, graph) == GGML_STATUS_SUCCESS);
+    CHECK(callback.remapped);
+    float result = 0.0f;
+    ggml_backend_tensor_get(output, &result, 0, sizeof(result));
+    CHECK(result == 21.0f);
+
+    // Backend assignment and source identity were fixed before callback time;
+    // only the allocated I32 payload changed.
+    CHECK(output->src[0] == experts);
+    CHECK(output->src[2] == ids);
+    CHECK(ggml_backend_sched_get_tensor_backend(sched, output) == backend);
+
+    ggml_backend_sched_free(sched);
+    ggml_free(ctx);
+}
+
+} // namespace
+
+int main() {
+    const auto path0 = temp_path("expert-0");
+    const auto path1 = temp_path("expert-1");
+    const auto bytes0 = make_bytes(2048, 11);
+    const auto bytes1 = make_bytes(2048, 73);
+    write_bytes(path0, bytes0);
+    write_bytes(path1, bytes1);
+
+    ggml_backend_t backend = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    CHECK(backend != nullptr);
+    test_scheduler_id_remap_boundary(backend);
+
+    const std::vector<std::string> paths = { path0.string(), path1.string() };
+    const llama_expert_stream_config config = { 2, 64, backend };
+    std::string error;
+
+    CHECK(!llama_expert_stream_metal_completion(backend, error));
+    CHECK(error.find("Metal") != std::string::npos);
+
+    set_feature(nullptr);
+    CHECK(!llama_expert_stream_cache::create(config, paths, error));
+    CHECK(error.find("not exactly 1") != std::string::npos);
+
+    set_feature("yes");
+    CHECK(!llama_expert_stream_cache::create(config, paths, error));
+    CHECK(error.find("invalid") != std::string::npos);
+
+    set_feature("1");
+    auto cache = llama_expert_stream_cache::create(config, paths, error);
+    CHECK(cache != nullptr && error.empty());
+    CHECK(cache->capacity_bytes() == 128);
+
+    llama_expert_stream_lease invalid_decode;
+    CHECK(!cache->acquire({ request_a() }, 2, invalid_decode, error));
+    CHECK(error.find("single-token") != std::string::npos);
+
+    auto invalid_type = request_a();
+    invalid_type.gate.type = GGML_TYPE_Q4_0;
+    CHECK(!cache->acquire({ invalid_type }, 1, invalid_decode, error));
+    CHECK(error.find("unsupported expert quant") != std::string::npos);
+
+    {
+        llama_expert_stream_lease lease;
+        CHECK(cache->acquire({ request_a() }, 1, lease, error));
+        CHECK(lease.views().size() == 1);
+        const auto & view = lease.views()[0];
+        CHECK(view.layer == 7 && view.expert == 401);
+        CHECK(view.gate.type == GGML_TYPE_IQ1_S);
+        CHECK(view.up.type == GGML_TYPE_IQ2_XXS);
+        CHECK(view.down.type == GGML_TYPE_IQ4_NL);
+        CHECK(std::memcmp(view.gate.data, bytes0.data() + 37, 17) == 0);
+        CHECK(std::memcmp(view.up.data, bytes1.data() + 101, 19) == 0);
+        CHECK(std::memcmp(view.down.data, bytes0.data() + 333, 23) == 0);
+        CHECK(view.up.buffer_offset == view.gate.buffer_offset + 17);
+        CHECK(view.down.buffer_offset == view.up.buffer_offset + 19);
+    }
+
+    {
+        llama_expert_stream_lease hit;
+        CHECK(cache->acquire({ request_a() }, 1, hit, error));
+        const auto stats = cache->stats();
+        CHECK(stats.hits == 1);
+        CHECK(stats.misses == 1);
+        CHECK(stats.read_bytes == 17 + 19 + 23);
+    }
+
+    {
+        llama_expert_stream_lease router_order;
+        CHECK(cache->acquire({ request_b(), request_a() }, 1, router_order, error));
+        CHECK(router_order.views().size() == 2);
+        CHECK(router_order.views()[0].expert == request_b().expert);
+        CHECK(router_order.views()[1].expert == request_a().expert);
+    }
+
+    // A single-slot cache cannot overwrite A while a completion object still
+    // owns its lease. This is the same ownership transition used by the Metal
+    // shared-event completion implementation.
+    const llama_expert_stream_config one_slot_config = { 1, 64, backend };
+    auto one_slot = llama_expert_stream_cache::create(one_slot_config, paths, error);
+    CHECK(one_slot != nullptr);
+
+    llama_expert_stream_lease in_flight;
+    CHECK(one_slot->acquire({ request_a() }, 1, in_flight, error));
+    auto state = std::make_shared<completion_state>();
+    CHECK(one_slot->retire(std::move(in_flight), std::make_unique<blocking_completion>(state), error));
+
+    llama_expert_stream_lease blocked;
+    CHECK(!one_slot->acquire({ request_b() }, 1, blocked, error));
+    CHECK(error.find("unfinished device work") != std::string::npos);
+
+    signal(state);
+    for (;;) {
+        llama_expert_stream_lease after_completion;
+        if (one_slot->acquire({ request_b() }, 1, after_completion, error)) {
+            const auto & view = after_completion.views()[0];
+            CHECK(std::memcmp(view.gate.data, bytes1.data() + 511, 16) == 0);
+            CHECK(std::memcmp(view.up.data, bytes0.data() + 701, 18) == 0);
+            CHECK(std::memcmp(view.down.data, bytes1.data() + 911, 24) == 0);
+            break;
+        }
+        std::this_thread::yield();
+    }
+    const auto one_slot_stats = one_slot->stats();
+    CHECK(one_slot_stats.evictions == 1);
+
+    // Exercise the real Metal shared-event completion path without evaluating
+    // a graph or opening model weights.
+    ggml_backend_t metal = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_GPU, nullptr);
+    if (metal != nullptr) {
+        const llama_expert_stream_config metal_config = { 1, 64, metal };
+        auto metal_cache = llama_expert_stream_cache::create(metal_config, paths, error);
+        CHECK(metal_cache != nullptr);
+        llama_expert_stream_lease metal_in_flight;
+        CHECK(metal_cache->acquire({ request_a() }, 1, metal_in_flight, error));
+        auto completion = llama_expert_stream_metal_completion(metal, error);
+        CHECK(completion != nullptr && error.empty());
+        CHECK(metal_cache->retire(std::move(metal_in_flight), std::move(completion), error));
+
+        bool metal_released = false;
+        for (size_t attempt = 0; attempt < 100000 && !metal_released; ++attempt) {
+            llama_expert_stream_lease next;
+            metal_released = metal_cache->acquire({ request_b() }, 1, next, error);
+            if (!metal_released) {
+                std::this_thread::yield();
+            }
+        }
+        CHECK(metal_released);
+        metal_cache.reset();
+
+        // Bind three strided expert tensors directly to one fixed Metal cache.
+        // This is the graph-build side of the launch boundary: scheduler-visible
+        // buffer identity is established before any route is evaluated.
+        llama_expert_stream_model_info info;
+        info.files = paths;
+        info.n_expert = 2;
+        info.n_expert_used = 1;
+        info.layers.resize(1);
+        auto & layout = info.layers[0];
+        layout.gate = { 256, 1, ggml_row_size(GGML_TYPE_IQ1_S, 256), GGML_TYPE_IQ1_S };
+        layout.up   = { 256, 1, ggml_row_size(GGML_TYPE_IQ2_XXS, 256), GGML_TYPE_IQ2_XXS };
+        layout.down = { 256, 1, ggml_row_size(GGML_TYPE_IQ4_NL, 256), GGML_TYPE_IQ4_NL };
+        layout.experts.resize(2);
+        for (uint32_t expert = 0; expert < 2; ++expert) {
+            auto & request = layout.experts[expert];
+            request.layer = 0;
+            request.expert = expert;
+            request.gate = { 0, 64 + expert*512, layout.gate.nbytes, layout.gate.type };
+            request.up   = { 0, 192 + expert*512, layout.up.nbytes, layout.up.type };
+            request.down = { 0, 320 + expert*512, layout.down.nbytes, layout.down.type };
+        }
+        auto runtime = llama_expert_stream_runtime::create(info, metal, error);
+        CHECK(runtime != nullptr && error.empty());
+        ggml_init_params graph_params = { 8*ggml_tensor_overhead(), nullptr, true };
+        ggml_context * graph_ctx = ggml_init(graph_params);
+        CHECK(graph_ctx != nullptr);
+        runtime->begin_graph(nullptr, 1);
+        const auto cache_tensors = runtime->make_layer_tensors(graph_ctx, 0);
+        CHECK(cache_tensors.gate->buffer == cache_tensors.up->buffer);
+        CHECK(cache_tensors.up->buffer == cache_tensors.down->buffer);
+        CHECK(cache_tensors.gate->nb[2] == cache_tensors.up->nb[2]);
+        CHECK(cache_tensors.up->nb[2] == cache_tensors.down->nb[2]);
+        CHECK(cache_tensors.gate->nb[2] % 4096 == 0);
+        ggml_free(graph_ctx);
+        runtime.reset();
+        ggml_backend_free(metal);
+    }
+
+    // Keep the open file's original bound, truncate the shard, and prove an
+    // exact positional read rejects EOF rather than retaining partial bytes.
+    auto short_cache = llama_expert_stream_cache::create(one_slot_config, paths, error);
+    CHECK(short_cache != nullptr);
+    std::filesystem::resize_file(path0, 340);
+    llama_expert_stream_lease short_read;
+    CHECK(!short_cache->acquire({ request_a() }, 1, short_read, error));
+    CHECK(error.find("short expert pread") != std::string::npos);
+
+    short_cache.reset();
+    one_slot.reset();
+    cache.reset();
+    ggml_backend_free(backend);
+    std::filesystem::remove(path0);
+    std::filesystem::remove(path1);
+    set_feature(nullptr);
+    return 0;
+}
