+    if (found == expert_eval_needs.end()) {
+        LLAMA_LOG_ERROR("%s: scheduler delivered an unrequested expert callback\n", __func__);
+        return false;
+    }
+    const uint8_t needs = found->second;
+    expert_eval_needs.erase(found);
+
+    if ((needs & 1) && !expert_stream->callback(tensor, false)) {
+        LLAMA_LOG_ERROR("%s: exact expert boundary failed: %s\n", __func__, expert_stream->last_error().c_str());
+        return false;
+    }
+    if ((needs & 2) && !cparams.cb_eval(tensor, false, cparams.cb_eval_user_data)) {
+        return false;
+    }
+    return true;
