+++ b/src/llama-expert-stream.h
@@ -0,0 +1,139 @@
+#pragma once
+
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+// Experimental Qwen4Exp single-token expert staging. This interface is private
+// to llama.cpp until the graph can stop after routing and resume with compact
+// expert tensors.
+struct llama_expert_stream_slice {
+    uint32_t  file_index = 0;
+    uint64_t  offset     = 0;
+    uint64_t  nbytes     = 0;
+    ggml_type type       = GGML_TYPE_COUNT;
+};
+
+struct llama_expert_stream_request {
+    uint32_t layer  = 0;
+    uint32_t expert = 0;
+
+    llama_expert_stream_slice gate;
+    llama_expert_stream_slice up;
+    llama_expert_stream_slice down;
+};
+
+struct llama_expert_stream_projection {
+    void * data = nullptr;
+    size_t buffer_offset = 0;
+    size_t nbytes = 0;
+    ggml_type type = GGML_TYPE_COUNT;
+};
+
+struct llama_expert_stream_view {
+    uint32_t layer  = 0;
+    uint32_t expert = 0;
+    uint32_t slot   = 0;
+
+    ggml_backend_buffer_t buffer = nullptr;
+    llama_expert_stream_projection gate;
+    llama_expert_stream_projection up;
+    llama_expert_stream_projection down;
+};
+
+struct llama_expert_stream_config {
+    size_t cache_slots = 0;
+    size_t slot_bytes  = 0;
+    ggml_backend_t backend = nullptr;
+};
+
+struct llama_expert_stream_stats {
+    uint64_t hits       = 0;
+    uint64_t misses     = 0;
+    uint64_t evictions  = 0;
+    uint64_t read_bytes = 0;
+};
+
+class llama_expert_stream_cache;
+
+class llama_expert_stream_lease {
+public:
+    llama_expert_stream_lease();
+    ~llama_expert_stream_lease();
+
+    llama_expert_stream_lease(llama_expert_stream_lease && other) noexcept;
+    llama_expert_stream_lease & operator=(llama_expert_stream_lease && other) noexcept;
+
+    llama_expert_stream_lease(const llama_expert_stream_lease &) = delete;
+    llama_expert_stream_lease & operator=(const llama_expert_stream_lease &) = delete;
+
+    const std::vector<llama_expert_stream_view> & views() const;
+    bool empty() const;
+
+private:
+    friend class llama_expert_stream_cache;
+
+    llama_expert_stream_cache * owner = nullptr;
+    std::vector<uint32_t> slots;
+    std::vector<llama_expert_stream_view> result_views;
+};
+
+// wait() must return only after every device command that can read a lease has
+// completed. The Metal implementation below uses a shared-event signal queued
+// after the graph command buffers.
+class llama_expert_stream_completion {
+public:
+    virtual ~llama_expert_stream_completion() = default;
+    virtual void wait() = 0;
+};
+
+class llama_expert_stream_cache {
+public:
+    static std::unique_ptr<llama_expert_stream_cache> create(
+            const llama_expert_stream_config & config,
+            const std::vector<std::string> & files,
+            std::string & error);
+
+    ~llama_expert_stream_cache();
+
+    llama_expert_stream_cache(const llama_expert_stream_cache &) = delete;
+    llama_expert_stream_cache & operator=(const llama_expert_stream_cache &) = delete;
+
+    // Requests and returned views retain router order. Only exact Qwen4Exp
+    // IQ1_S/IQ2_XXS gate/up plus IQ4_NL down slices are accepted.
+    bool acquire(
+            const std::vector<llama_expert_stream_request> & requests,
+            uint32_t n_tokens,
+            llama_expert_stream_lease & lease,
+            std::string & error);
+
+    // Transfers slot ownership to the completion worker. A slot is not an
+    // eviction candidate until completion->wait() has returned.
+    bool retire(
+            llama_expert_stream_lease && lease,
+            std::unique_ptr<llama_expert_stream_completion> completion,
+            std::string & error);
+
+    llama_expert_stream_stats stats() const;
+    size_t capacity_bytes() const;
+
+private:
+    friend class llama_expert_stream_lease;
+    struct impl;
+
+    explicit llama_expert_stream_cache(std::unique_ptr<impl> pimpl);
+    void release(std::vector<uint32_t> && slots);
+
+    std::unique_ptr<impl> pimpl;
+};
+
+// Records a Metal shared event after work already submitted on backend. Returns
+// null for every non-Metal backend or if events are unavailable.
+std::unique_ptr<llama_expert_stream_completion> llama_expert_stream_metal_completion(
+        ggml_backend_t backend,
+        std::string & error);
