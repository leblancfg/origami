{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://origami.invalid/schemas/model-manifest.v1.json",
  "title": "Origami model artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "entrypoint", "shards"],
  "properties": {
    "schema_version": { "const": "origami.model-manifest.v1" },
    "model": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "revision", "format", "quantization"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "format": { "const": "GGUF" },
        "quantization": { "type": "string", "minLength": 1 }
      }
    },
    "entrypoint": { "type": "string", "minLength": 1 },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    }
  }
}
